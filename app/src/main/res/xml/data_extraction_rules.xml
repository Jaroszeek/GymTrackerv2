<?xml version="1.0" encoding="utf-8"?>
<!-- Health Connect data never leaves the phone (D-060); the rest of the backup rules come with Etap 9 (A5.10) -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="health.db" />
        <exclude domain="database" path="health.db-shm" />
        <exclude domain="database" path="health.db-wal" />
        <exclude domain="database" path="health.db-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="health.db" />
        <exclude domain="database" path="health.db-shm" />
        <exclude domain="database" path="health.db-wal" />
        <exclude domain="database" path="health.db-journal" />
    </device-transfer>
</data-extraction-rules>
